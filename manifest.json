{
  "id": "example.weather",
  "name": "Weather App",
  "version": "0.1.0",
  "framework": "react",
  "entry": "./remoteEntry.js",
  "description": "A weather application that displays current weather information",
  "permissions": {
    "network": {
      "allowed": true,
      "domains": ["hihi"]
    },
    "storage": {
      "allowed": true,
      "type": "localStorage"
    },
    "system": {
      "allowed": false
    }
  },
  "window": {
    "defaultSize": { "width": 800, "height": 500 },
    "resizable": true,
    "allowMultiple": true
  }
}
