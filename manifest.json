{
  "id": "example.weather",
  "name": "Weather App",
  "version": "0.1.0",
  "description": "A weather application that displays current weather information",
  "permissions": {
    "network": ["api.open-meteo.com"],
    "storage": ["localStorage"]
  },
  "window": {
    "defaultSize": { "width": 800, "height": 500 },
    "resizable": true,
    "allowMultiple": true
  }
}
